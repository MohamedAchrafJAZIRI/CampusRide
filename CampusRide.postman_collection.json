{
  "info": {
    "name": "CampusRide",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "tripId",
      "value": "1"
    },
    {
      "key": "cityId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create trip (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('tripId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departureTime\": \"2027-06-01T08:00:00\",\n  \"price\": 8.5,\n  \"seats\": 3,\n  \"driver\": { \"id\": 1 },\n  \"departureCity\": { \"id\": 1 },\n  \"arrivalCity\": { \"id\": 2 }\n}"
        },
        "url": "{{baseUrl}}/api/trips"
      }
    },
    {
      "name": "2. Create trip invalid price (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departureTime\": \"2027-06-01T08:00:00\",\n  \"price\": -5,\n  \"seats\": 3,\n  \"driver\": { \"id\": 1 },\n  \"departureCity\": { \"id\": 1 },\n  \"arrivalCity\": { \"id\": 2 }\n}"
        },
        "url": "{{baseUrl}}/api/trips"
      }
    },
    {
      "name": "3. Get all trips (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips"
      }
    },
    {
      "name": "4. Get created trip (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips/{{tripId}}"
      }
    },
    {
      "name": "5. Get trip 999 (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips/999"
      }
    },
    {
      "name": "6. Update created trip (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departureTime\": \"2027-06-02T09:00:00\",\n  \"price\": 7,\n  \"seats\": 4,\n  \"driver\": { \"id\": 1 },\n  \"departureCity\": { \"id\": 1 },\n  \"arrivalCity\": { \"id\": 2 }\n}"
        },
        "url": "{{baseUrl}}/api/trips/{{tripId}}"
      }
    },
    {
      "name": "7. Custom query: search Tunis -> Sousse (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips/search?from=Tunis&to=Sousse"
      }
    },
    {
      "name": "8. Custom query: cheap trips (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips/cheap?max=10"
      }
    },
    {
      "name": "9. Create review (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great driver\",\n  \"trip\": { \"id\": 1 },\n  \"author\": { \"id\": 2 }\n}"
        },
        "url": "{{baseUrl}}/api/reviews"
      }
    },
    {
      "name": "10. Custom query: driver rating (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips/driver/1/rating"
      }
    },
    {
      "name": "11. Create booking (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passenger\": { \"id\": 2 },\n  \"trip\": { \"id\": 1 }\n}"
        },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "12. Create student invalid email (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali\",\n  \"email\": \"not-an-email\"\n}"
        },
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "13. Create temporary city (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('cityId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Temp City\"\n}"
        },
        "url": "{{baseUrl}}/api/cities"
      }
    },
    {
      "name": "14. Delete that city (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/cities/{{cityId}}"
      }
    }
  ]
}